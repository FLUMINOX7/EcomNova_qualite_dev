# Configuration de la base de données PostgreSQL
# Copier ce fichier vers .env et modifier les valeurs selon votre configuration

# Local machine (sans Docker)
DATABASE_URL=postgresql://ecomnova_user:1234@localhost:5432/ecomnova

# Docker Compose (le service Postgres s'appelle 'db')
# DATABASE_URL=postgresql://ecomnova_user:1234@db:5432/ecomnova

# JWT secret (changez en production)
JWT_SECRET_KEY=dev-secret-key-change-in-production
